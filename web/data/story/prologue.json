        {
          "id": "n5",
          "speaker": "{name}",
          "text": "（她認識我。是房東吧？……該怎麼回答才好？）",
          "next": "ask"
        },
        {
          "id": "ask",
          "speaker": null,
          "text": "要怎麼回答？",
          "choices": [
