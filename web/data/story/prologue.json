        {
          "id": "n2",
          "speaker": null,
          "text": "門開了。冷空氣從樓梯間湧上來，帶著煤煙和濕石頭的味道。",
          "next": "n3"
        },
        {
          "id": "n3",
          "speaker": "{name}",
