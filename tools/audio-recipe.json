  "renders": [
    {
      "id": "city_waltz",
      "source": "northivanastan-death-waltz",
      "midi": "death_waltz.mid",
      "soundfont": "fluidr3-gm",
      "fromBar": 12,
      "toBar": 60,
      "repeats": 2,
      "gain": 0.5,
      "tracks": {
        "1": {
          "channel": 6
        }
      },
      "channels": {
        "0": {
          "program": 21,
          "velocity": 0.85
        },
        "6": {
          "program": 49,
          "velocity": 0.7,
          "controls": {
            "7": 117,
            "10": 64,
            "91": 0,
            "93": 0
          }
        },
        "3": {
          "program": 32,
          "velocity": 0.8
        },
        "4": {
          "program": 45,
          "velocity": 0.75
        },
        "5": {
          "drop": true
        }
      },
      "note": "旋律（弦樂）→ 手風琴；魯特琴和弦 → 弦樂撥奏；低音吉他 → 原聲貝斯；低音弦樂（與旋律同聲道，先搬到第 6 聲道，帶入原聲道的音量 117、聲相置中、無殘響）→ 慢速弦樂；拿掉銅管。取第 12～59 小節（兩次完整旋律段，約 86.4 秒）"
    }
  ],
